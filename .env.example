MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tr-tech?retryWrites=true&w=majority
PORT=5000
NODE_ENV=production
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET_MIN_32_CHARS
FRONTEND_URL=https://tr-tech-frontend.vercel.app
VERCEL=1
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_ACTUAL_SECRET
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_ACTUAL_PUBLIC
# Webhook secret is REQUIRED for HMAC verification of incoming Paystack events.
# Generate this in your Paystack dashboard under Settings > Webhooks.
# Do NOT reuse PAYSTACK_SECRET_KEY here; they serve different purposes.
PAYSTACK_WEBHOOK_SECRET=whsec_REPLACE_WITH_ACTUAL_WEBHOOK_SECRET

# Vercel Blob (production). Generate at https://vercel.com/dashboard -> Storage -> Blob.
# When set, uploads route files there instead of writing to the local ./uploads
# directory (which is ephemeral on Vercel). When unset, the local-disk fallback is used.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_WITH_ACTUAL_TOKEN
BLOB_STORE_ID=store_REPLACE_WITH_ACTUAL_STORE_ID

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=TR-Tech <info@trtech.co.za>

# IMPORTANT: Copy this file to .env and replace all REPLACE_WITH_ACTUAL_* values.
# Do NOT commit real secrets to version control.
