MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tr-tech?retryWrites=true&w=majority
PORT=5000
NODE_ENV=production
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
FRONTEND_URL=https://tr-tech-frontend.vercel.app
VERCEL=1
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET_HERE
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PAYSTACK_PUBLIC_HERE

# Vercel Blob (production). Generate at https://vercel.com/dashboard -> Storage -> Blob.
# When set, uploads route files there instead of writing to the local ./uploads
# directory (which is ephemeral on Vercel). When unset, the local-disk fallback is used.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx_your_token_here
BLOB_STORE_ID=store_xxx_your_store_id_here
